# Reference only. Preserve your existing full server environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CHECKOUT_ACCESS_SECRET=REPLACE_WITH_A_STABLE_LONG_RANDOM_SECRET
# Keep the existing value for an existing installation with encrypted credentials.
PAYMENT_CONFIG_ENCRYPTION_KEY=RETAIN_EXISTING_KEY_OR_GENERATE_FOR_NEW_INSTALLATION
TRUST_PROXY=loopback
CHECKOUT_RESERVATION_HOURS=24
DISABLE_JOBS=false
# Configure Razorpay keyId, keySecret and webhookSecret in payment administration.
# Frontend environment: COMMERCE_API_BASE_URL=https://api.nmama.in/api

# Register this >=32-character shared secret as x-api-key with Shadowfax callbacks.
SHADOWFAX_WEBHOOK_SECRET=

# Deployment-specific values; preserve existing domain origins.
NODE_ENV=production
PORT=3011
CORS_ORIGINS=https://nmama.in,https://www.nmama.in
# Add your exact HTTPS admin origin above. Fail-closed Shiprocket callback authentication:
SHIPPING_WEBHOOK_SECRET=
