  updatedAt   DateTime                   @updatedAt
  deliveries  PushNotificationDelivery[]

  @@index([status, scheduledAt])
}

model PushNotificationDelivery {
  id                Int              @id @default(autoincrement())
  notificationId    Int
  deviceId          Int
  status            String           @default("PENDING")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  notification      PushNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([status])
}

model MobileAppSetting {
  key       String   @id
  value     Json
  isPublic  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AccessibilityIssue {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   String
  field      String
  severity   String   @default("WARNING")
  code       String
  message    String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([resolved, severity])
}
