generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Customer
  Admin
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  PartiallyFulfilled
  Fulfilled
  Shipped
  Delivered
  Cancelled
  Returned
}

enum PaymentStatus {
  Pending
  Created
  PartiallyPaid
  Paid
  Failed
  PartiallyRefunded
  Refunded
}

enum PaymentProvider {
  Razorpay
  COD
  BankTransfer
  Manual
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  COD
  Prepaid
  BANK_TRANSFER
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum ShippingProvider {
  Shiprocket
  Delhivery
  Manual
}

enum ShipmentStatus {
  NotCreated
  Created
  Picked
  InTransit
  OutForDelivery
  Delivered
  RTO
  Cancelled
  Failed
}

enum ReviewStatus {
  Pending
  Approved
  Rejected
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  OTHER
}

enum SliderDevice {
  DESKTOP
  MOBILE
}

model User {
  id                       Int               @id @default(autoincrement())
  firstName                String
  lastName                 String
  email                    String            @unique
  passwordHash             String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  isActive                 Boolean           @default(true)
  emailVerified            Boolean           @default(false)
  emailVerifiedAt          DateTime?
  emailVerifyToken         String?           @unique
  emailVerifyTokenExpiry   DateTime?
  phone                    String?           @unique
  resetPasswordToken       String?           @unique
  resetPasswordTokenExpiry DateTime?
  role                     UserRole          @default(Customer)
  cartItems                CartItem[]
  mediaAssets              MediaAsset[]      @relation("UserMediaAssets")
  orders                   Order[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
  addresses                CustomerAddress[]
  recentlyViewed           RecentlyViewed[]
  searches                 SearchHistory[]
  returnRequests           ReturnRequest[]
  supportTickets           SupportTicket[]
  authIdentities           AuthIdentity[]
  staffProfile             StaffProfile?
}

model Product {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  imageUrl             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  isActive             Boolean                @default(true)
  isFeatured           Boolean                @default(false)
  apContentHtml        String?
  apContentImageUrl    String?
  apContentVideoUrl    String?
  categoryId           Int?
  productType          String?                @default("simple")
  shortDescriptionHtml String?
  subCategoryId        Int?
  canonicalUrl         String?
  metaDescription      String?
  metaKeywords         String?
  metaTitle            String?
  ogImageUrl           String?
  slug                 String                 @unique
  couponProducts       CouponProduct[]
  orderItems           OrderItem[]
  category             Category?              @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory?           @relation(fields: [subCategoryId], references: [id])
  colorGroups          ProductColorGroup[]
  images               ProductImage[]
  productTags          ProductTag[]
  variants             ProductVariant[]
  reviews              Review[]
  wishlistedBy         WishlistItem[]
  options              ProductOption[]
  collections          CollectionProduct[]
  relatedFrom          RelatedProduct[]       @relation("RelatedFrom")
  relatedTo            RelatedProduct[]       @relation("RelatedTo")
  recentlyViewed       RecentlyViewed[]
  specifications       ProductSpecification[]
  sizeGuide            SizeGuide?
  brandId              Int?
  brand                Brand?                 @relation(fields: [brandId], references: [id])
  media                ProductMedia[]
  hsnSac               String?
  taxClass             String?
  translations         ProductTranslation[]
  regionalPrices       RegionalPrice[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
}

model ProductVariant {
  id                     Int                   @id @default(autoincrement())
  productId              Int
  weight                 String?
  size                   String?
  color                  String?
  colorHex               String?
  colorImageUrl          String?
  price                  Decimal               @db.Decimal(18, 2)
  discountPrice          Decimal?              @db.Decimal(18, 2)
  stockQuantity          Int
  sku                    String?               @unique
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  lastLowStockNotifiedAt DateTime?
  lowStockAlertAt        Int                   @default(5)
  colorGroupId           Int?
  optionValues           Json? // Shopify-like arbitrary option map, e.g. {"Size":"4Y","Color":"Pink"}
  barcode                String?
  compareAtPrice         Decimal?              @db.Decimal(18, 2)
  costPrice              Decimal?              @db.Decimal(18, 2)
  trackInventory         Boolean               @default(true)
  allowBackorder         Boolean               @default(false)
  preorderEnabled        Boolean               @default(false)
  cartItems              CartItem[]
  orderItems             OrderItem[]
  colorGroup             ProductColorGroup?    @relation(fields: [colorGroupId], references: [id])
  product                Product               @relation(fields: [productId], references: [id])
  images                 ProductVariantImage[]
  guestCartItems         GuestCartItem[]

  @@index([productId])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  userId    Int
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variantId Int
  user      User           @relation(fields: [userId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model Order {
  id                  Int               @id @default(autoincrement())
  userId              Int?
  totalAmount         Decimal           @db.Decimal(18, 2)
  shippingAddress     String?
  shippingCity        String?
  shippingCountry     String?
  shippingPostalCode  String?
  guestPhone          String?
  customerEmail       String?
  customerName        String?
  orderDate           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryDate        DateTime?
  deliveryTimeSlot    String?
  currency            String            @default("INR")
  paidAmount          Decimal?          @db.Decimal(18, 2)
  razorpayOrderId     String?           @unique
  awbNumber           String?
  couponCode          String?
  couponDiscount      Decimal?          @db.Decimal(18, 2)
  couponId            Int?
  deliveredAt         DateTime?
  shipmentId          String?
  shipmentStatus      ShipmentStatus    @default(NotCreated)
  shippedAt           DateTime?
  shippingFee         Decimal?          @db.Decimal(18, 2)
  shippingMeta        Json?
  shippingProvider    ShippingProvider?
  trackingCode        String?
  trackingUrl         String?
  status              OrderStatus       @default(Pending)
  paymentMethod       PaymentMethod?
  paymentStatus       PaymentStatus     @default(Pending)
  orderNotes          String?
  giftMessage         String?
  billingAddress      Json?
  shippingAddressJson Json?
  deliveryOption      String?
  expressCheckout     Boolean           @default(false)
  subtotal            Decimal?          @db.Decimal(18, 2)
  taxAmount           Decimal?          @db.Decimal(18, 2)
  discountAmount      Decimal?          @db.Decimal(18, 2)
  refundedAmount      Decimal           @default(0) @db.Decimal(18, 2)
  paymentDue          Decimal?          @db.Decimal(18, 2)
  internalNotes       String?
  cancellationReason  String?
  cancelledAt         DateTime?
  customerGstin       String?
  invoiceNumber       String?           @unique
  invoiceIssuedAt     DateTime?
  taxInclusive        Boolean           @default(true)
  taxBreakdown        Json?
  coupon              Coupon?           @relation(fields: [couponId], references: [id])
  user                User?             @relation(fields: [userId], references: [id])
  orderItems          OrderItem[]
  payments            Payment[]

  @@index([userId])
  @@index([couponId])
  @@index([shippingProvider])
  @@index([shipmentStatus])
}

model Payment {
  id                Int             @id @default(autoincrement())
  orderId           Int
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal         @db.Decimal(18, 2)
  currency          String          @default("INR")
  isCaptured        Boolean         @default(false)
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  provider          PaymentProvider @default(Razorpay)
  paymentStatus     PaymentStatus
  paymentMethod     PaymentMethod?
  order             Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id                Int            @id @default(autoincrement())
  orderId           Int
  productId         Int
  quantity          Int
  unitPrice         Decimal        @db.Decimal(18, 2)
  variantId         Int
  imageUrl          String?
  productName       String
  sku               String?
  variantLabel      String?
  fulfilledQuantity Int            @default(0)
  refundedQuantity  Int            @default(0)
  returnedQuantity  Int            @default(0)
  order             Order          @relation(fields: [orderId], references: [id])
  product           Product        @relation(fields: [productId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Category {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  imageUrl         String?
  couponCategories CouponCategory[]
  products         Product[]
  subCategories    SubCategory[]
}

model SubCategory {
  id                  Int                 @id @default(autoincrement())
  categoryId          Int
  name                String
  slug                String              @unique
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  imageUrl            String?
  couponSubCategories CouponSubCategory[]
  products            Product[]
  category            Category            @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  productTags ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@index([tagId])
}

model Coupon {
  id                  Int                 @id @default(autoincrement())
  code                String              @unique
  description         String?
  isActive            Boolean             @default(true)
  discountType        CouponDiscountType
  percentOff          Decimal?            @db.Decimal(5, 2)
  amountOff           Decimal?            @db.Decimal(18, 2)
  minOrderAmount      Decimal?            @db.Decimal(18, 2)
  maxDiscount         Decimal?            @db.Decimal(18, 2)
  startAt             DateTime?
  endAt               DateTime?
  usageLimit          Int?
  usagePerUser        Int?
  usedCount           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  couponCategories    CouponCategory[]
  couponProducts      CouponProduct[]
  couponSubCategories CouponSubCategory[]
  orders              Order[]
}

model CouponProduct {
  couponId  Int
  productId Int
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   Int
  categoryId Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  coupon     Coupon   @relation(fields: [couponId], references: [id])

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponSubCategory {
  couponId      Int
  subCategoryId Int
  createdAt     DateTime    @default(now())
  coupon        Coupon      @relation(fields: [couponId], references: [id])
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@id([couponId, subCategoryId])
  @@index([subCategoryId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId])
}

model ProductVariantImage {
  id        Int            @id @default(autoincrement())
  variantId Int
  url       String
  altText   String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, url])
  @@index([variantId])
}

model Review {
  id        Int           @id @default(autoincrement())
  productId Int
  userId    Int?
  rating    Int
  title     String?
  comment   String?
  status    ReviewStatus  @default(Pending)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])
  images    ReviewImage[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
}

model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  url       String
  publicId  String?
  altText   String?
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model MediaAsset {
  id               Int       @id @default(autoincrement())
  publicId         String    @unique
  url              String
  secureUrl        String?
  type             MediaType
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  folder           String?
  originalName     String?
  uploadedByUserId Int?
  createdAt        DateTime  @default(now())
  uploadedBy       User?     @relation("UserMediaAssets", fields: [uploadedByUserId], references: [id])

  @@index([type])
  @@index([folder])
  @@index([createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model HomeSlider {
  id        String           @id @default(cuid())
  key       String           @unique @default("home")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     HomeSliderItem[]
}

model HomeSliderItem {
  id         String       @id @default(cuid())
  sliderId   String
  device     SliderDevice
  imageUrl   String
  heading    String?
  subHeading String?
  ctaText    String?
  ctaHref    String?
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  slider     HomeSlider   @relation(fields: [sliderId], references: [id], onDelete: Cascade)

  @@index([sliderId, device, isActive, sortOrder])
}

model BannerGrid {
  id              String   @id @default(cuid())
  banner1ImageUrl String
  banner1CtaUrl   String
  banner2ImageUrl String
  banner2CtaUrl   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductColorGroup {
  id        Int                 @id @default(autoincrement())
  productId Int
  color     String
  colorHex  String?
  createdAt DateTime            @default(now())
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductColorImage[]
  variants  ProductVariant[]

  @@unique([productId, color])
  @@index([productId])
}

model ProductColorImage {
  id           Int               @id @default(autoincrement())
  colorGroupId Int
  url          String
  altText      String?
  sortOrder    Int               @default(0)
  colorGroup   ProductColorGroup @relation(fields: [colorGroupId], references: [id], onDelete: Cascade)

  @@index([colorGroupId])
}

// =============================================================
// COMMERCE V2 — Shopify-style extensibility and requested modules
// =============================================================
model ProductOption {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  position  Int     @default(0)
  values    Json
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductSpecification {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  value     String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model SizeGuide {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  title     String
  content   Json
  imageUrl  String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model RelatedProduct {
  productId        Int
  relatedProductId Int
  position         Int     @default(0)
  product          Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model ProductMedia {
  id           Int              @id @default(autoincrement())
  productId    Int
  type         ProductMediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  altText      String?
  sortOrder    Int              @default(0)
  isMain       Boolean          @default(false)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([productId, sortOrder])
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model Collection {
  id          Int                 @id @default(autoincrement())
  name        String
  slug        String              @unique
  description String?
  imageUrl    String?
  type        CollectionType      @default(MANUAL)
  rules       Json?
  isFeatured  Boolean             @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean             @default(true)
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CollectionProduct {
  collectionId Int
  productId    Int
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

enum CollectionType {
  MANUAL
  AUTOMATIC
  SEASONAL
}

model CustomerAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  query      String
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
}

model Warehouse {
  id            Int                  @id @default(autoincrement())
  name          String
  code          String               @unique
  address       Json?
  isActive      Boolean              @default(true)
  inventory     WarehouseInventory[]
  transfersFrom StockTransfer[]      @relation("TransferFrom")
  transfersTo   StockTransfer[]      @relation("TransferTo")
}

model WarehouseInventory {
  warehouseId Int
  variantId   Int
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([warehouseId, variantId])
  @@index([variantId])
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  status          StockTransferStatus @default(DRAFT)
  items           Json
  notes           String?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  gstin          String?
  address        Json?
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         Int                 @id @default(autoincrement())
  supplierId Int
  status     PurchaseOrderStatus @default(DRAFT)
  items      Json
  total      Decimal?            @db.Decimal(18, 2)
  expectedAt DateTime?
  receivedAt DateTime?
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdAt  DateTime            @default(now())
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model ReturnRequest {
  id            Int          @id @default(autoincrement())
  userId        Int?
  orderId       Int
  type          ReturnType   @default(RETURN)
  status        ReturnStatus @default(REQUESTED)
  reason        String
  items         Json
  resolution    Json?
  reversePickup Json?
  refundAmount  Decimal?     @db.Decimal(18, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User?        @relation(fields: [userId], references: [id])

  @@index([orderId])
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  EXCHANGED
  CLOSED
}

model Promotion {
  id        Int           @id @default(autoincrement())
  name      String
  code      String?       @unique
  type      PromotionType
  rules     Json
  benefit   Json
  startsAt  DateTime?
  endsAt    DateTime?
  priority  Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum PromotionType {
  PERCENT
  FIXED
  BOGO
  BUNDLE
  QUANTITY
  FLASH
  CUSTOMER_PRICE
  GIFT_CARD
}

model CmsPage {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  content         Json
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SeoRedirect {
  id         Int     @id @default(autoincrement())
  fromPath   String  @unique
  toPath     String
  statusCode Int     @default(301)
  isActive   Boolean @default(true)
}

model Faq {
  id       Int     @id @default(autoincrement())
  question String
  answer   String
  category String?
  position Int     @default(0)
  isActive Boolean @default(true)
}

model SupportTicket {
  id        Int            @id @default(autoincrement())
  userId    Int?
  orderId   Int?
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  user      User?          @relation(fields: [userId], references: [id])
